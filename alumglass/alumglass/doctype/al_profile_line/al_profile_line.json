{
 "doctype": "DocType",
 "name": "AL Profile Line",
 "module": "Alumglass",
 "istable": 1,
 "fields": [
  {
   "fieldname": "sort_order",
   "label": "Sort Order",
   "fieldtype": "Int",
   "reqd": 1,
   "default": 0
  },
  {
   "fieldname": "line_type",
   "label": "Line Type",
   "fieldtype": "Select",
   "options": "Aluminum\nGlass\nConsumable\nAccessory",
   "reqd": 1
  },
  {
   "fieldname": "line_name",
   "label": "Line Name",
   "fieldtype": "Data",
   "reqd": 1
  },
  {
   "fieldname": "slug",
   "label": "Slug",
   "fieldtype": "Data",
   "read_only": 1
  },
  {
   "fieldname": "group_tag",
   "label": "Group Tag",
   "fieldtype": "Data"
  },
  {
   "fieldname": "show_condition",
   "label": "Show Condition",
   "fieldtype": "Code"
  },
  {
   "fieldname": "cost_bucket",
   "label": "Cost Bucket",
   "fieldtype": "Link",
   "options": "AL Cost Bucket"
  },
  {
   "fieldname": "is_active",
   "label": "Is Active",
   "fieldtype": "Check",
   "default": 1
  },
  {
   "fieldname": "item_code",
   "label": "Item Code",
   "fieldtype": "Link",
   "options": "Item",
   "depends_on": "eval:['Aluminum','Glass','Consumable','Accessory'].includes(doc.line_type)"
  },
  {
   "fieldname": "quantity_rule",
   "label": "Quantity Rule",
   "fieldtype": "Link",
   "options": "AL Calculation Rule",
   "depends_on": "eval:['Aluminum','Consumable'].includes(doc.line_type)"
  },
  {
   "fieldname": "qty_formula",
   "label": "Qty Formula",
   "fieldtype": "Code",
   "depends_on": "eval:['Aluminum','Consumable'].includes(doc.line_type)"
  },
  {
   "fieldname": "price_type",
   "label": "Price Type",
   "fieldtype": "Select",
   "options": "Item Price\nRule\nFixed",
   "depends_on": "eval:['Aluminum','Glass','Consumable'].includes(doc.line_type)"
  },
  {
   "fieldname": "price_rule",
   "label": "Price Rule",
   "fieldtype": "Link",
   "options": "AL Calculation Rule",
   "depends_on": "eval:doc.price_type=='Rule'"
  },
  {
   "fieldname": "fixed_price",
   "label": "Fixed Price",
   "fieldtype": "Currency",
   "depends_on": "eval:doc.price_type=='Fixed'"
  },
  {
   "fieldname": "price_list",
   "label": "Price List",
   "fieldtype": "Link",
   "options": "Price List",
   "depends_on": "eval:doc.price_type=='Item Price'"
  },
  {
   "fieldname": "ctx_inject_prefix",
   "label": "Context Inject Prefix",
   "fieldtype": "Data",
   "depends_on": "eval:doc.line_type=='Glass'"
  },
  {
   "fieldname": "default_glass_master",
   "label": "Default Glass Master",
   "fieldtype": "Link",
   "options": "AL Glass Master",
   "depends_on": "eval:doc.line_type=='Glass'"
  },
  {
   "fieldname": "width_rule",
   "label": "Width Rule",
   "fieldtype": "Link",
   "options": "AL Calculation Rule",
   "depends_on": "eval:doc.line_type=='Glass'"
  },
  {
   "fieldname": "height_rule",
   "label": "Height Rule",
   "fieldtype": "Link",
   "options": "AL Calculation Rule",
   "depends_on": "eval:doc.line_type=='Glass'"
  },
  {
   "fieldname": "width_formula",
   "label": "Width Formula",
   "fieldtype": "Code",
   "depends_on": "eval:doc.line_type=='Glass'"
  },
  {
   "fieldname": "height_formula",
   "label": "Height Formula",
   "fieldtype": "Code",
   "depends_on": "eval:doc.line_type=='Glass'"
  },
  {
   "fieldname": "panel_count_formula",
   "label": "Panel Count Formula",
   "fieldtype": "Code",
   "depends_on": "eval:doc.line_type=='Glass'"
  },
  {
   "fieldname": "panel_glass_override_allowed",
   "label": "Panel Glass Override Allowed",
   "fieldtype": "Check",
   "depends_on": "eval:doc.line_type=='Glass'"
  },
  {
   "fieldname": "qty_per_panel_formula",
   "label": "Qty Per Panel Formula",
   "fieldtype": "Code",
   "default": "1",
   "depends_on": "eval:doc.line_type=='Glass'"
  },
  {
   "fieldname": "cut_fee_pct",
   "label": "Cut Fee (%)",
   "fieldtype": "Float",
   "default": 0,
   "depends_on": "eval:doc.line_type=='Glass'"
  },
  {
   "fieldname": "sl_formula",
   "label": "SL Formula",
   "fieldtype": "Code",
   "depends_on": "eval:doc.line_type=='Accessory'"
  },
  {
   "fieldname": "allow_substitute",
   "label": "Allow Substitute",
   "fieldtype": "Check",
   "depends_on": "eval:doc.line_type=='Accessory'"
  },
  {
   "fieldname": "substitute_item_group",
   "label": "Substitute Item Group",
   "fieldtype": "Link",
   "options": "Item Group",
   "depends_on": "eval:doc.line_type=='Accessory' && doc.allow_substitute==1"
  }
 ],
 "permissions": [
  {
   "role": "alumglass Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "alumglass Technical",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0
  },
  {
   "role": "alumglass Sales",
   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 0
  }
 ]
}